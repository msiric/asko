{
  "name": "Reminder Bot",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "set-reminder",
        "responseMode": "responseNode"
      },
      "id": "webhook-trigger",
      "name": "Reminder Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [250, 300]
    },
    {
      "parameters": {
        "model": "local-default",
        "messages": {
          "values": [
            {
              "role": "system",
              "content": "You are a reminder parser. Extract the reminder text and the time from the user's message. Return a JSON object with 'reminder' (string) and 'delay_minutes' (integer). Example: {\"reminder\": \"Buy milk\", \"delay_minutes\": 60}. If no specific time is mentioned, default to 30 minutes."
            },
            {
              "role": "user",
              "content": "={{ $json.body.message }}"
            }
          ]
        },
        "options": {
          "maxTokens": 256,
          "temperature": 0.1
        }
      },
      "id": "ai-parse",
      "name": "Parse Reminder",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1,
      "position": [500, 300],
      "credentials": {
        "openAiApi": {
          "id": "litellm",
          "name": "LiteLLM"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ status: 'Reminder set', parsed: $json.message.content }) }}"
      },
      "id": "respond",
      "name": "Confirm",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [750, 300]
    }
  ],
  "connections": {
    "Reminder Webhook": {
      "main": [
        [{ "node": "Parse Reminder", "type": "main", "index": 0 }]
      ]
    },
    "Parse Reminder": {
      "main": [
        [{ "node": "Confirm", "type": "main", "index": 0 }]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "meta": {
    "description": "Natural language reminder bot. Send 'Remind me to buy milk in 1 hour' and it parses the intent and schedules a notification."
  }
}
