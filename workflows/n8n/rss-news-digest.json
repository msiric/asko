{
  "name": "RSS News Digest",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 7 * * *"
            }
          ]
        }
      },
      "id": "cron-trigger",
      "name": "Every Morning 7AM",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [250, 300]
    },
    {
      "parameters": {
        "url": "https://www.index.hr/rss"
      },
      "id": "rss-croatian",
      "name": "Croatian News (Index.hr)",
      "type": "n8n-nodes-base.rssFeedRead",
      "typeVersion": 1,
      "position": [450, 200]
    },
    {
      "parameters": {
        "url": "https://ct24.ceskatelevize.cz/rss/hlavni-zpravy"
      },
      "id": "rss-czech",
      "name": "Czech News (CT24)",
      "type": "n8n-nodes-base.rssFeedRead",
      "typeVersion": 1,
      "position": [450, 400]
    },
    {
      "parameters": {
        "mode": "append"
      },
      "id": "merge",
      "name": "Merge News",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [650, 300]
    },
    {
      "parameters": {
        "model": "local-default",
        "messages": {
          "values": [
            {
              "role": "system",
              "content": "You are asko, a news summarizer. Summarize the top 5 most important stories from the provided RSS items. For each story: one headline and 2-3 sentences. Write in English. Keep the total under 300 words."
            },
            {
              "role": "user",
              "content": "Here are today's news items: {{ JSON.stringify($json) }}"
            }
          ]
        },
        "options": {
          "maxTokens": 512,
          "temperature": 0.3
        }
      },
      "id": "ai-summarize",
      "name": "AI Summarize",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1,
      "position": [850, 300]
    },
    {
      "parameters": {},
      "id": "send-notification",
      "name": "Send to Telegram",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [1050, 300]
    }
  ],
  "connections": {
    "Every Morning 7AM": {
      "main": [[{"node": "Croatian News (Index.hr)", "type": "main", "index": 0}, {"node": "Czech News (CT24)", "type": "main", "index": 0}]]
    },
    "Croatian News (Index.hr)": {
      "main": [[{"node": "Merge News", "type": "main", "index": 0}]]
    },
    "Czech News (CT24)": {
      "main": [[{"node": "Merge News", "type": "main", "index": 1}]]
    },
    "Merge News": {
      "main": [[{"node": "AI Summarize", "type": "main", "index": 0}]]
    },
    "AI Summarize": {
      "main": [[{"node": "Send to Telegram", "type": "main", "index": 0}]]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "meta": {
    "description": "Daily news digest from Croatian (Index.hr) and Czech (CT24) RSS feeds, AI-summarized in English. Replace 'Send to Telegram' no-op with a Telegram node. Add or swap RSS feeds to customize.",
    "instanceId": "",
    "templateCredsSetupCompleted": false
  }
}
