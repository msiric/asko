model_list:
  # === LOCAL MODELS (Ollama, free, private) ===
  - model_name: "local-default"
    litellm_params:
      model: "ollama/qwen3:4b"
      api_base: "http://ollama:11434"
      stream: true
    model_info:
      description: "Qwen3 4B - fast, multilingual (119 langs), best quality/speed ratio"

  - model_name: "local-large"
    litellm_params:
      model: "ollama/qwen3:8b"
      api_base: "http://ollama:11434"
      stream: true
    model_info:
      description: "Qwen3 8B - more capable, slower on CPU"

  - model_name: "local-fast"
    litellm_params:
      model: "ollama/llama3.2:3b"
      api_base: "http://ollama:11434"
      stream: true
    model_info:
      description: "Llama 3.2 3B - fastest responses, English-focused"

  - model_name: "local-embed"
    litellm_params:
      model: "ollama/nomic-embed-text"
      api_base: "http://ollama:11434"
    model_info:
      description: "Nomic Embed Text - local embeddings for RAG"

  # === CLOUD MODELS (optional, requires API keys) ===
  - model_name: "cloud-smart"
    litellm_params:
      model: "anthropic/claude-sonnet-4-20250514"
      api_key: "os.environ/ANTHROPIC_API_KEY"
    model_info:
      description: "Claude Sonnet 4 - cloud fallback for complex tasks"

  - model_name: "cloud-opus"
    litellm_params:
      model: "anthropic/claude-opus-4-20250514"
      api_key: "os.environ/ANTHROPIC_API_KEY"
    model_info:
      description: "Claude Opus - highest quality for critical tasks"

  - model_name: "cloud-fast"
    litellm_params:
      model: "openai/gpt-4o-mini"
      api_key: "os.environ/OPENAI_API_KEY"
    model_info:
      description: "GPT-4o Mini - cheap cloud overflow"

  - model_name: "cloud-embed"
    litellm_params:
      model: "openai/text-embedding-3-small"
      api_key: "os.environ/OPENAI_API_KEY"

router_settings:
  fallbacks:
    - local-default: ["local-large", "cloud-fast", "cloud-smart"]
    - local-large: ["cloud-smart"]
    - local-embed: ["cloud-embed"]
  context_window_fallbacks:
    - local-default: ["local-large", "cloud-smart"]
  num_retries: 2
  allowed_fails: 3
  cooldown_time: 60

general_settings:
  master_key: "os.environ/LITELLM_MASTER_KEY"
  database_url: "os.environ/DATABASE_URL"
  store_model_in_db: true

litellm_settings:
  drop_params: true
  set_verbose: false
