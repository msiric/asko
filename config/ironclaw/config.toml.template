# IronClaw configuration for asko
# LLM backend is configured via environment variables (LLM_BACKEND, LLM_BASE_URL, etc.)
# This file configures the WASM sandbox, security, and gateway settings.

[gateway]
enabled = true
bind = "0.0.0.0:3000"
auth_mode = "token"

[wasm]
# WASM sandbox limits for tool execution
max_memory = 67108864        # 64 MB per module
fuel_limit = 1000000000      # Prevents infinite loops
http_timeout_secs = 30

[wasm.http_allowlist]
allowed_hosts = [
    "api.telegram.org",
    "litellm",
]

[security]
# Enable prompt injection defense
safety_layer = true
# Require approval for destructive operations
approval_required = true
# Enable leak detection for secrets in requests/responses
leak_detection = true

[memory]
# Use PostgreSQL with pgvector for hybrid search
backend = "postgres"
# Embeddings via litellm
embeddings_provider = "openai_compatible"
embeddings_base_url = "http://litellm:4000/v1"
embeddings_model = "local-embed"

[heartbeat]
enabled = true
interval_secs = 300
