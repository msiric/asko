# ============================================================
# asko Environment Configuration
# Copy this to .env and fill in your values, or run ./setup.sh
# ============================================================

# --- PostgreSQL ---
POSTGRES_USER=asko
POSTGRES_PASSWORD=CHANGE_ME_run_setup_sh
POSTGRES_DB=asko

# --- Database URLs (derived from PostgreSQL credentials) ---
DATABASE_URL=postgresql://asko:CHANGE_ME@postgres:5432/asko
IRONCLAW_DATABASE_URL=postgresql://asko:CHANGE_ME@postgres:5432/asko_ironclaw
OPENWEBUI_DATABASE_URL=postgresql://asko:CHANGE_ME@postgres:5432/asko_openwebui

# --- LiteLLM ---
LITELLM_MASTER_KEY=sk-asko-CHANGE_ME
LITELLM_SALT_KEY=CHANGE_ME

# --- IronClaw ---
IRONCLAW_SECRETS_MASTER_KEY=CHANGE_ME

# --- n8n ---
N8N_ENCRYPTION_KEY=CHANGE_ME
N8N_USER_MANAGEMENT_JWT_SECRET=CHANGE_ME
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=CHANGE_ME

# --- Open WebUI ---
OPENWEBUI_SECRET_KEY=CHANGE_ME

# --- Cloud LLM API Keys (optional — leave empty for local-only) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Domain ---
DOMAIN_BASE=asko.local
