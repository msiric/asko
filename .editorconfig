root = true

[*]
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
charset = utf-8

[*.{sh,bash,bats}]
indent_style = space
indent_size = 4

[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.{json}]
indent_style = space
indent_size = 2

[*.{toml}]
indent_style = space
indent_size = 4

[*.{md}]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

[Caddyfile*]
indent_style = tab

[Makefile]
indent_style = tab

[docker-compose.yml]
indent_style = space
indent_size = 2
